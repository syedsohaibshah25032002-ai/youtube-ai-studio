# Application
NEXT_PUBLIC_APP_NAME="YouTube AI Studio"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (Auth.js / NextAuth v5)
# Generate a secret with: npx auth secret
AUTH_SECRET="your-auth-secret"
# NextAuth URL (optional; defaults to request origin)
AUTH_URL="http://localhost:3000"
# Trust host when behind a proxy in production
AUTH_TRUST_HOST="true"

# Database (Prisma + SQLite)
DATABASE_URL="file:./dev.db"

# Future integrations (uncomment and fill in when implemented)
# YouTube Data API v3
# YOUTUBE_API_KEY="your-youtube-api-key"
