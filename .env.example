# Application
NEXT_PUBLIC_APP_NAME="YouTube AI Studio"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (Auth.js / NextAuth v5)
# Generate a secret with: npx auth secret
AUTH_SECRET="your-auth-secret"
# NextAuth URL (optional; defaults to request origin)
AUTH_URL="http://localhost:3000"
# Trust host when behind a proxy in production
AUTH_TRUST_HOST="true"

# Database (Prisma + SQLite)
DATABASE_URL="file:./dev.db"

# YouTube Data API v3 (optional for now)
# Set this to fetch real channel data. Without it, mock data is used.
YOUTUBE_API_KEY=""

# YouTube OAuth 2.0 (secure channel connection)
# Create credentials at https://console.cloud.google.com/apis/credentials
# OAuth client type: Web application. Authorized redirect URI must match
# YOUTUBE_OAUTH_REDIRECT_URI below.
YOUTUBE_OAUTH_CLIENT_ID=""
YOUTUBE_OAUTH_CLIENT_SECRET=""
YOUTUBE_OAUTH_REDIRECT_URI="http://localhost:3000/api/youtube/callback"
# Optional: space-separated scopes. Defaults to youtube.readonly + youtube.upload.
YOUTUBE_OAUTH_SCOPES=""
# Provider: leave unset to auto-detect (Google when credentials are present,
# mock otherwise). Set "google" to require real credentials, or "mock" to
# simulate connections.
YOUTUBE_PROVIDER=""
# Key used to encrypt OAuth tokens at rest. Falls back to AUTH_SECRET when unset.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
YOUTUBE_TOKEN_ENCRYPTION_KEY=""

# AI Content Engine
# Leave AI_PROVIDER unset (or set to "mock") to use deterministic mock content.
# To use a real provider, set AI_PROVIDER="openai" and provide your own key.
# The provider is OpenAI-API compatible, so AI_BASE_URL can point to any
# compatible endpoint (OpenAI, Azure, Ollama, local proxies, etc.).
AI_PROVIDER="mock"
AI_API_KEY="your-api-key"
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# AI Media Engine
# Leave MEDIA_PROVIDER unset (or set to "mock") to use deterministic mock images.
# To use a real provider, set MEDIA_PROVIDER="openai" and provide your own key.
# The provider is OpenAI-API compatible, so MEDIA_BASE_URL can point to any
# compatible images endpoint (OpenAI DALL·E, compatible proxies, etc.).
MEDIA_PROVIDER="mock"
MEDIA_API_KEY="your-api-key"
MEDIA_BASE_URL="https://api.openai.com/v1"
MEDIA_MODEL="dall-e-3"

# AI Video Engine
# Leave VIDEO_PROVIDER unset (or set to "mock") to use deterministic mock videos.
# To use a real provider, set VIDEO_PROVIDER="openai" and provide your own key.
# The provider is OpenAI-API compatible, so VIDEO_BASE_URL can point to any
# compatible video endpoint (OpenAI, compatible proxies, etc.).
VIDEO_PROVIDER="mock"
VIDEO_API_KEY="your-api-key"
VIDEO_BASE_URL="https://api.openai.com/v1"
VIDEO_MODEL="video-gen"

# Video Rendering & Export
# Renders completed video jobs into a final MP4. Leave unset to auto-detect a
# system ffmpeg binary (used when available) and fall back to a mock renderer
# otherwise. Set RENDER_PROVIDER="mock" to force the simulated renderer.
RENDER_PROVIDER="ffmpeg"
