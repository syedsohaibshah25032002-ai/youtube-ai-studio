generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  channels      Channel[]
  aiJobs        AiJob[]
  mediaAssets   MediaAsset[]

  @@map("users")
}

model Channel {
  id              String   @id @default(cuid())
  userId          String
  name            String
  channelId       String
  thumbnailUrl    String?
  subscriberCount Int      @default(0)
  uploadDefaults  Json
  settings        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos Video[]
  aiJobs AiJob[]

  @@unique([userId, channelId])
  @@index([userId])
  @@map("channels")
}

model Video {
  id            String    @id @default(cuid())
  channelId     String
  title         String
  description   String?
  tags          Json      @default("[]")
  categoryId    String?
  visibility    String    @default("public")
  thumbnailUrl  String?
  publishStatus String    @default("draft")
  scheduledAt   DateTime?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@map("videos")
}

model AiJob {
  id        String   @id @default(cuid())
  userId    String
  topic     String
  channelId String?
  provider  String
  model     String
  status    String   @default("PENDING")
  progress  Int      @default(0)
  errorLog  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel?          @relation(fields: [channelId], references: [id], onDelete: SetNull)
  results AiSectionResult[]

  @@index([userId])
  @@index([status])
  @@map("ai_jobs")
}

model AiSectionResult {
  id        String   @id @default(cuid())
  jobId     String
  section   String
  content   Json
  provider  String
  model     String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job AiJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, section])
  @@index([jobId])
  @@map("ai_section_results")
}

model MediaAsset {
  id          String    @id @default(cuid())
  userId      String
  title       String
  type        String
  prompt      String
  status      String    @default("PENDING")
  provider    String
  model       String
  mediaUrl    String?
  width       Int?
  height      Int?
  errorLog    Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs MediaGenerationRun[]

  @@index([userId])
  @@index([status])
  @@map("media_assets")
}

model MediaGenerationRun {
  id         String    @id @default(cuid())
  assetId    String
  status     String    @default("PENDING")
  provider   String
  model      String
  prompt     String
  mediaUrl   String?
  width      Int?
  height     Int?
  errorLog   Json      @default("[]")
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([status])
  @@map("media_generation_runs")
}
