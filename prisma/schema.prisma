generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  channels      Channel[]
  aiJobs        AiJob[]
  mediaAssets   MediaAsset[]
  videoJobs     VideoJob[]
  videoRenders  VideoRender[]
  youtubeConnections YoutubeConnection[]
  youtubeUploads     YoutubeUpload[]

  @@map("users")
}

model Channel {
  id              String   @id @default(cuid())
  userId          String
  name            String
  channelId       String
  thumbnailUrl    String?
  subscriberCount Int      @default(0)
  uploadDefaults  Json
  settings        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos Video[]
  aiJobs AiJob[]

  @@unique([userId, channelId])
  @@index([userId])
  @@map("channels")
}

model Video {
  id            String    @id @default(cuid())
  channelId     String
  title         String
  description   String?
  tags          Json      @default("[]")
  categoryId    String?
  visibility    String    @default("public")
  thumbnailUrl  String?
  publishStatus String    @default("draft")
  scheduledAt   DateTime?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@map("videos")
}

model AiJob {
  id        String   @id @default(cuid())
  userId    String
  topic     String
  channelId String?
  provider  String
  model     String
  status    String   @default("PENDING")
  progress  Int      @default(0)
  errorLog  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel?          @relation(fields: [channelId], references: [id], onDelete: SetNull)
  results AiSectionResult[]
  videoJobs VideoJob[]

  @@index([userId])
  @@index([status])
  @@map("ai_jobs")
}

model AiSectionResult {
  id        String   @id @default(cuid())
  jobId     String
  section   String
  content   Json
  provider  String
  model     String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job AiJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, section])
  @@index([jobId])
  @@map("ai_section_results")
}

model MediaAsset {
  id          String    @id @default(cuid())
  userId      String
  title       String
  type        String
  prompt      String
  status      String    @default("PENDING")
  provider    String
  model       String
  mediaUrl    String?
  width       Int?
  height      Int?
  errorLog    Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs MediaGenerationRun[]

  @@index([userId])
  @@index([status])
  @@map("media_assets")
}

model MediaGenerationRun {
  id         String    @id @default(cuid())
  assetId    String
  status     String    @default("PENDING")
  provider   String
  model      String
  prompt     String
  mediaUrl   String?
  width      Int?
  height     Int?
  errorLog   Json      @default("[]")
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([status])
  @@map("media_generation_runs")
}

model VideoJob {
  id              String    @id @default(cuid())
  userId          String
  aiJobId         String?
  title           String
  status          String    @default("PENDING")
  progress        Int       @default(0)
  stage           String    @default("")
  provider        String
  model           String
  config          Json
  script          String    @default("")
  timeline        Json      @default("[]")
  outputPath      String?
  durationSeconds Int?
  width           Int?
  height          Int?
  errorLog        Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  finishedAt      DateTime?

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiJob   AiJob?                @relation(fields: [aiJobId], references: [id], onDelete: SetNull)
  runs    VideoGenerationRun[]
  renders VideoRender[]

  @@index([userId])
  @@index([status])
  @@index([aiJobId])
  @@map("video_jobs")
}

model VideoGenerationRun {
  id              String    @id @default(cuid())
  videoJobId      String
  status          String    @default("PENDING")
  provider        String
  model           String
  progress        Int       @default(0)
  timeline        Json      @default("[]")
  outputPath      String?
  durationSeconds Int?
  width           Int?
  height          Int?
  errorLog        Json      @default("[]")
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())

  videoJob VideoJob @relation(fields: [videoJobId], references: [id], onDelete: Cascade)

  @@index([videoJobId])
  @@index([status])
  @@map("video_generation_runs")
}

model VideoRender {
  id              String    @id @default(cuid())
  userId          String
  videoJobId      String
  resolution      String    @default("1080p")
  status          String    @default("PENDING")
  progress        Int       @default(0)
  stage           String    @default("")
  provider        String
  model           String
  outputPath      String?
  durationSeconds Int?
  width           Int?
  height          Int?
  previewImages   Json      @default("[]")
  errorLog        Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  finishedAt      DateTime?

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoJob  VideoJob           @relation(fields: [videoJobId], references: [id], onDelete: Cascade)
  runs      VideoRenderRun[]

  @@index([userId])
  @@index([videoJobId])
  @@index([status])
  @@map("video_renders")
}

model VideoRenderRun {
  id              String    @id @default(cuid())
  renderId        String
  status          String    @default("PENDING")
  provider        String
  model           String
  progress        Int       @default(0)
  resolution      String    @default("1080p")
  outputPath      String?
  durationSeconds Int?
  width           Int?
  height          Int?
  previewImages   Json      @default("[]")
  errorLog        Json      @default("[]")
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())

  render VideoRender @relation(fields: [renderId], references: [id], onDelete: Cascade)

  @@index([renderId])
  @@index([status])
  @@map("video_render_runs")
}

model YoutubeConnection {
  id                  String    @id @default(cuid())
  userId              String    @unique
  channelId           String
  channelName         String
  channelUrl          String?
  thumbnailUrl        String?
  subscriberCount     Int       @default(0)
  status              String    @default("CONNECTED")
  provider            String
  tokensEncrypted     String
  tokenExpiresAt      DateTime?
  scope               String?
  lastError           String?
  lastCheckedAt       DateTime?
  connectedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("youtube_connections")
}

model YoutubeUpload {
  id               String    @id @default(cuid())
  userId           String
  renderId         String
  videoJobId       String?
  title            String
  description      String    @default("")
  tags             Json      @default("[]")
  categoryId       String    @default("")
  visibility       String    @default("private")
  status           String    @default("PENDING")
  progress         Int       @default(0)
  stage            String    @default("")
  videoId          String?
  videoUrl         String?
  thumbnailPath    String?
  errorLog         Json      @default("[]")
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, renderId])
  @@index([userId])
  @@index([status])
  @@map("youtube_uploads")
}
